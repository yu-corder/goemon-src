function int test1(int a) {

    function int test2(int b) {

        function int test3(int c) {

            function int test4(int d) {

                function int test5(int e) {

                    function int test6(int f) {

                        function int test7(int g) {

                            function int test8(int h) {

                                function int test9(int i) {

                                    function int test10(int j) {
                                        return j + 1;
                                    }

                                    return test10(i);
                                }

                                return test9(h);
                            }

                            return test8(g);
                        }
                        return test7(f);
                    }
                    return test6(e);
                }
                return test5(d);
            }
            return test4(c);
        }
        return test3(b);
    }
    return test2(a);
}


print test1(100);